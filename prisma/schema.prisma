generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum PlatformRole {
  SUPER_ADMIN
  MERCHANT_OWNER
  MERCHANT_STAFF
}

enum StaffRole {
  MANAGER
  SHIPMENT_MANAGER
  CUSTOMER_SUPPORT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum MerchantStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum ShipmentStatus {
  SHIPMENT_CREATED
  ORDER_CONFIRMED
  LABEL_CREATED
  PICKED_UP
  PROCESSING
  DEPARTED_FACILITY
  IN_TRANSIT
  ARRIVED_AT_FACILITY
  CUSTOMS_PROCESSING
  CUSTOMS_CLEARED
  HELD_AT_CUSTOMS
  DELAYED
  OUT_FOR_DELIVERY
  DELIVERY_ATTEMPTED
  DELIVERED
  RETURNED
  CANCELLED
}

enum EventVisibility {
  PUBLIC
  INTERNAL
}

enum ConversationStatus {
  OPEN
  ARCHIVED
}

enum MessageSenderType {
  CUSTOMER
  MERCHANT
}

enum NotificationRecipientType {
  SUPER_ADMIN
  MERCHANT
}

enum NotificationType {
  SHIPMENT_CREATED
  SHIPMENT_STATUS_CHANGED
  SHIPMENT_DELAYED
  SHIPMENT_DELIVERED
  NEW_MESSAGE
  MESSAGE_REPLY
  MERCHANT_CREATED
  MERCHANT_STATUS_CHANGED
}

// ---------- Models ----------

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  username       String       @unique
  passwordHash   String
  name           String
  role           PlatformRole
  staffRole      StaffRole?
  status         UserStatus   @default(ACTIVE)
  merchantId     String?
  merchant       Merchant?    @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  resetToken       String?   @unique
  resetTokenExpiry DateTime?
  lastLoginAt      DateTime?

  createdEvents    TrackingEvent[] @relation("EventCreatedBy")
  sentMessages     Message[]       @relation("MessageSender")
  notifications    Notification[]
  auditLogs        AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([merchantId])
  @@index([role])
}

model Merchant {
  id           String         @id @default(cuid())
  merchantCode String         @unique
  businessName String?
  merchantName String?
  email        String         @unique
  phone        String?
  businessAddress String?
  country      String?
  city         String?
  status       MerchantStatus @default(ACTIVE)
  logoUrl      String?
  notificationPrefs Json?

  users         User[]
  shipments     Shipment[]
  conversations Conversation[]
  notifications Notification[]
  auditLogs     AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Shipment {
  id             String   @id @default(cuid())
  trackingNumber String   @unique
  referenceId    String?
  merchantId     String
  merchant       Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  // Shipment info
  shipmentType    String
  description     String
  quantity        Int      @default(1)
  weight          Float?
  dimensions      String?
  service         String
  cost            Float?
  currency        String   @default("USD")
  insurance       Boolean  @default(false)
  estimatedDelivery DateTime?
  status          ShipmentStatus @default(SHIPMENT_CREATED)
  archived        Boolean  @default(false)

  // Route
  origin            String
  destination        String
  currentLocation     String?
  departureLocation   String?
  arrivalLocation     String?

  // Sender
  senderName    String
  senderCompany String?
  senderEmail   String?
  senderPhone   String?
  senderAddress String
  senderCity    String
  senderState   String?
  senderCountry String
  senderPostal  String?

  // Recipient
  recipientName    String
  recipientCompany String?
  recipientEmail   String?
  recipientPhone   String?
  recipientAddress String
  recipientCity    String
  recipientState   String?
  recipientCountry String
  recipientPostal  String?

  trackingEvents TrackingEvent[]
  conversations  Conversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([merchantId])
  @@index([status])
  @@index([recipientCountry])
  @@index([createdAt])
}

model TrackingEvent {
  id          String          @id @default(cuid())
  shipmentId  String
  shipment    Shipment        @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status      ShipmentStatus
  location    String
  occurredAt  DateTime        @default(now())
  description String
  internalNote String?
  visibility  EventVisibility @default(PUBLIC)

  createdByUserId String?
  createdByUser   User?   @relation("EventCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([shipmentId])
  @@index([occurredAt])
}

model Customer {
  id    String  @id @default(cuid())
  email String
  name  String
  phone String?

  conversations Conversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model Conversation {
  id         String              @id @default(cuid())
  shipmentId String
  shipment   Shipment            @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  merchantId String
  merchant   Merchant            @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  status     ConversationStatus  @default(OPEN)
  lastMessageAt DateTime         @default(now())

  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([merchantId])
  @@index([shipmentId])
  @@index([status])
}

model Message {
  id             String            @id @default(cuid())
  conversationId String
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderType     MessageSenderType
  senderUserId   String?
  senderUser     User?             @relation("MessageSender", fields: [senderUserId], references: [id], onDelete: SetNull)
  body           String
  readAt         DateTime?

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@index([createdAt])
}

model Notification {
  id            String                     @id @default(cuid())
  recipientType NotificationRecipientType
  userId        String?
  user          User?                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchantId    String?
  merchant      Merchant?                  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  type          NotificationType
  title         String
  body          String
  entityType    String?
  entityId      String?
  read          Boolean                    @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([merchantId])
  @@index([read])
  @@index([createdAt])
}

model AuditLog {
  id            String   @id @default(cuid())
  actorUserId   String?
  actorUser     User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorLabel    String
  action        String
  entityType    String
  entityId      String?
  merchantId    String?
  merchant      Merchant? @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  previousValue Json?
  newValue      Json?
  ipAddress     String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([merchantId])
}

model PlatformSettings {
  id                  String  @id @default("singleton")
  platformName        String  @default("ShipTrack")
  logoUrl             String?
  supportEmail        String?
  notificationsEnabled Boolean @default(true)
  trackingUrlBase     String? @default("/track")

  updatedAt DateTime @updatedAt
}
